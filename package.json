{
  "name": "@pahooper/soundforge",
  "version": "0.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node tools/build.mjs && node tools/prepare-examples.mjs",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "analyze": "node dist/analyze.js",
    "test:browser": "node test/browser.cjs",
    "test:production": "npm run build && node test/production.cjs",
    "test:catalog-browser": "node test/browser-component.cjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build && npm test && npm run test:package",
    "test:package": "node tools/verify-package.mjs",
    "build:site": "node tools/build-site.mjs",
    "test:docs": "node test/docs.test.mjs"
  },
  "dependencies": {
    "@audio/decode": "^4.2.0"
  },
  "devDependencies": {
    "@lucide/svelte": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "marked": "^18.1.1",
    "playwright": "^1.0.0",
    "svelte": "^5.57.2",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "description": "Embeddable audio player and catalog browser with playlists, layered mixes, and audio visualization preprocessing.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./player": {
      "types": "./types/player.d.ts",
      "import": "./dist/audio-player.js",
      "default": "./dist/audio-player.js"
    },
    "./browser": {
      "types": "./types/browser.d.ts",
      "import": "./dist/audio-browser.js",
      "default": "./dist/audio-browser.js"
    },
    "./helpers": {
      "types": "./types/helpers.d.ts",
      "import": "./dist/helpers.js",
      "default": "./dist/helpers.js"
    },
    "./connect": {
      "types": "./types/connect.d.ts",
      "import": "./dist/connect.js",
      "default": "./dist/connect.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "soundforge-analyze": "./dist/analyze.js"
  },
  "files": [
    "dist",
    "types",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "RELEASE.md",
    "examples",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "docs/reference.md",
    "docs/preprocessing.md",
    "docs/recipes.md",
    "docs/troubleshooting.md",
    "docs/development.md",
    "docs/verification-v0.3.4.md",
    "docs/releases.md"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/audio-player.js",
    "./dist/audio-browser.js",
    "./src/*.svelte",
    "./src/register.ts",
    "./src/browser-register.ts"
  ],
  "keywords": [
    "audio",
    "web-components",
    "svelte",
    "playlist",
    "audio-mixer",
    "visualization"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pahooper/soundforge.git"
  },
  "bugs": {
    "url": "https://github.com/pahooper/soundforge/issues"
  },
  "homepage": "https://github.com/pahooper/soundforge#readme"
}
